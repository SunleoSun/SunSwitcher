{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SunSwitcher: build release",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "--locked",
        "--bin",
        "sunswitcher"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}